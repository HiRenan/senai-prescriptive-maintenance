# Reopen only parent paths needed to reach the web file allowlist.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/
apps/*
!apps/web/
apps/web/*
!apps/web/index.html
!apps/web/package.json
!apps/web/server.mjs
!apps/web/vite.config.ts
!apps/web/public/
apps/web/public/*
!apps/web/public/favicon.svg
!apps/web/public/theme-init.js
!apps/web/src/
apps/web/src/*
!apps/web/src/**/
!apps/web/src/**/*.css
!apps/web/src/**/*.js
!apps/web/src/**/*.svg
!apps/web/src/**/*.ts
!apps/web/src/**/*.tsx
apps/web/src/**/*.d.ts
apps/web/src/**/tests/
